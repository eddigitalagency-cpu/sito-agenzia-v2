---
import Navbar from '../components/Navbar';
import CustomCursor from '../components/CustomCursor';
import CookieBanner from '../components/CookieBanner';
import { dict, HTML_LANG, OG_LOCALE, stripLangPrefix, withLang, type Lang } from '../i18n/dictionary';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  // Article-specific SEO
  ogType?: 'website' | 'article';
  articleDate?: string;      // ISO string
  articleModified?: string;  // ISO string
  articleAuthor?: string;
  articleSection?: string;
  pageKeywords?: string;     // Overrides generic keywords when provided
  lang?: Lang;
}
const {
  title,
  description,
  ogImage = '/Images/Logo_Bianco_ED.webp',
  ogType = 'website',
  articleDate,
  articleModified,
  articleAuthor,
  articleSection,
  pageKeywords,
  lang = 'it',
} = Astro.props;

const t = dict[lang];

const canonicalURL  = new URL(Astro.url.pathname, 'https://eddigitalagency.it');
const fullTitle     = `${title} — ED Digital Agency`;
const ogImageAbs    = new URL(ogImage, 'https://eddigitalagency.it').toString();
const pageDescription = description ?? t.seo.defaultDescription;
const defaultKeywords = t.seo.defaultKeywords;

// Hreflang alternates — same page across all three locales, plus x-default (IT)
const basePath = stripLangPrefix(Astro.url.pathname);
const hreflangAlternates: { lang: string; href: string }[] = [
  { lang: 'it', href: new URL(basePath, 'https://eddigitalagency.it').toString() },
  { lang: 'en', href: new URL(withLang(basePath, 'en'), 'https://eddigitalagency.it').toString() },
  { lang: 'de', href: new URL(withLang(basePath, 'de'), 'https://eddigitalagency.it').toString() },
  { lang: 'x-default', href: new URL(basePath, 'https://eddigitalagency.it').toString() },
];

// ── JSON-LD @graph — factual NAP stays identical across locales, copy is translated ──
const offerNames: Record<Lang, string[]> = {
  it: ['Social Media Management a Treviso', 'Advertising Digitale a Treviso', 'Siti Web a Treviso', 'E-Commerce a Treviso', 'Foto e Video Professionale', 'Visual Identity e Logo Design', 'Sviluppo MVP, SaaS e Gestionali su Misura', 'Sviluppo App Mobile', 'Integrazioni e Automazioni'],
  en: ['Social Media Management', 'Digital Advertising', 'Website Development', 'E-Commerce Development', 'Professional Photo & Video', 'Brand Identity & Logo Design', 'MVP, SaaS & Custom Business Software Development', 'Mobile App Development', 'Integrations & Automation'],
  de: ['Social Media Management', 'Digitales Advertising', 'Website-Entwicklung', 'E-Commerce-Entwicklung', 'Professionelle Foto- & Videoproduktion', 'Corporate Design & Logo-Design', 'MVP-, SaaS- & individuelle Businesssoftware-Entwicklung', 'App-Entwicklung', 'Integrationen & Automatisierung'],
};
const offerSlugs = ['social-media-management', 'advertising', 'website', 'ecommerce', 'photo-video', 'visual-identity', 'mvp-saas', 'app', 'integrazioni'];
const catalogName: Record<Lang, string> = { it: 'Servizi Digitali per PMI', en: 'Digital Services', de: 'Digitale Leistungen' };

const jsonLdGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'LocalBusiness', 'ProfessionalService'],
      '@id': 'https://eddigitalagency.it/#organization',
      name: 'ED Digital Agency',
      alternateName: ['ED Digital', 'ED Digital Agency Treviso'],
      url: 'https://eddigitalagency.it',
      logo: { '@type': 'ImageObject', url: 'https://eddigitalagency.it/Images/Logo%20ED%20Digitla.png', width: 400, height: 400 },
      image: 'https://eddigitalagency.it/Images/Logo%20ED%20Digitla.png',
      description: t.seo.orgDescription,
      foundingDate: '2019',
      telephone: '+39 379 3248371',
      email: 'info@eddigitalagency.it',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Via Carlo Torres, 17/Interno 13',
        addressLocality: 'Vittorio Veneto',
        addressRegion: 'Treviso',
        postalCode: '31029',
        addressCountry: 'IT',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 45.9826, longitude: 12.3001 },
      areaServed: [
        { '@type': 'City', name: 'Vittorio Veneto' },
        { '@type': 'City', name: 'Treviso' },
        { '@type': 'City', name: 'Conegliano' },
        { '@type': 'City', name: 'Pieve di Soligo' },
        { '@type': 'City', name: 'Montebelluna' },
        { '@type': 'City', name: 'Castelfranco Veneto' },
        { '@type': 'City', name: 'Oderzo' },
        { '@type': 'City', name: 'Valdobbiadene' },
        { '@type': 'City', name: 'Mogliano Veneto' },
        { '@type': 'City', name: 'Venezia' },
        { '@type': 'City', name: 'Padova' },
        { '@type': 'AdministrativeArea', name: 'Provincia di Treviso' },
        { '@type': 'State', name: 'Veneto' },
        { '@type': 'Country', name: 'Italia' },
        { '@type': 'Country', name: 'Austria' },
      ],
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+39-379-3248371',
        email: 'info@eddigitalagency.it',
        contactType: 'customer service',
        availableLanguage: ['Italian', 'English', 'German'],
        areaServed: ['IT', 'AT', 'EU'],
      },
      openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '09:00', closes: '18:00' }],
      sameAs: ['https://www.instagram.com/eddigitalagency', 'https://www.linkedin.com/company/ed-digital-agency'],
      knowsLanguage: ['it', 'en', 'de'],
      priceRange: '€€',
      knowsAbout: [
        'Social Media Management', 'Advertising Meta e Google Ads', 'Sviluppo Siti Web',
        'E-Commerce', 'Fotografia e Video Making', 'Visual Identity e Brand Design',
        'Sviluppo Software Gestionale Personalizzato', 'Applicazioni Web su Misura per Aziende',
        'Sviluppo MVP e SaaS', 'Sviluppo App Mobile iOS e Android', 'Integrazioni e Automazioni Aziendali',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: catalogName[lang],
        itemListElement: offerSlugs.map((slug, i) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: offerNames[lang][i], url: `https://eddigitalagency.it${withLang('/servizi/' + slug, lang)}` },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://eddigitalagency.it/#website',
      url: 'https://eddigitalagency.it',
      name: t.seo.websiteName,
      description: t.seo.websiteDescription,
      publisher: { '@id': 'https://eddigitalagency.it/#organization' },
      inLanguage: HTML_LANG[lang],
      potentialAction: {
        '@type': 'SearchAction',
        target: `https://eddigitalagency.it${withLang('/servizi', lang)}?q={search_term_string}`,
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL}#webpage`,
      url: canonicalURL.toString(),
      name: fullTitle,
      isPartOf: { '@id': 'https://eddigitalagency.it/#website' },
      about: { '@id': 'https://eddigitalagency.it/#organization' },
      inLanguage: HTML_LANG[lang],
      speakable: { '@type': 'SpeakableSpecification', cssSelector: ['h1', 'h2', '.speakable'] },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.seo.faq.map(f => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={HTML_LANG[lang]} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ── Primary SEO ──────────────────────────────────────── -->
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords || defaultKeywords} />
    <meta name="author" content={articleAuthor || 'ED Digital Agency'} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalURL} />
    {hreflangAlternates.map(a => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

    <!-- ── Geo ─────────────────────────────────────────────── -->
    <meta name="geo.region" content="IT-TV" />
    <meta name="geo.placename" content="Vittorio Veneto, Treviso, Conegliano, Veneto" />
    <meta name="geo.position" content="45.9826;12.3001" />
    <meta name="ICBM" content="45.9826, 12.3001" />
    <meta name="DC.coverage" content="Vittorio Veneto, Treviso, Conegliano, Montebelluna, Castelfranco Veneto, Oderzo, Veneto, Italia" />

    <!-- ── Open Graph ──────────────────────────────────────── -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {(['it','en','de'] as const).filter(l => l !== lang).map(l => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:site_name" content="ED Digital Agency" />
    {ogType === 'article' && articleDate    && <meta property="article:published_time" content={articleDate} />}
    {ogType === 'article' && articleModified && <meta property="article:modified_time" content={articleModified} />}
    {ogType === 'article' && articleAuthor  && <meta property="article:author" content={articleAuthor} />}
    {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}

    <!-- ── Twitter Card ────────────────────────────────────── -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- ── Icons & Theme ───────────────────────────────────── -->
    <link rel="icon" type="image/png" href="/Images/Logo%20ED%20Digitla.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#FF6A00" />
    <meta name="msapplication-TileColor" content="#FF6A00" />

    <!-- ── Preload critical fonts ─────────────────────────── -->
    <link rel="preload" href="/fonts/CalSans-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/GraphikLCG-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href="/fonts/GraphikLCG-Light.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

    <!-- ── JSON-LD Structured Data ────────────────────── -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLdGraph)} />

    <!-- ── Page-specific head (JSON-LD, extra meta) ─────────── -->
    <slot name="head" />

    <!-- ── Flash prevention: apply saved theme before paint ── -->
    <script is:inline>
      (function(){var t=localStorage.getItem('ed-theme');if(t==='light')document.documentElement.classList.add('light');})();
    </script>

    <style is:global>
      /* ── Custom Fonts ──────────────────────────────────────── */
      @font-face {
        font-family: 'CalSans';
        src: url('/fonts/CalSans-Regular.woff2') format('woff2'),
             url('/fonts/CalSans-Regular.ttf') format('truetype');
        font-weight: 400 700;
        font-display: swap;
      }
      /* Critical weights preloaded above — font-display:swap avoids FOIT */
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Regular.woff2') format('woff2');    font-weight:400; font-display:swap; }
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Light.woff2') format('woff2');      font-weight:300; font-display:swap; }
      /* Non-critical weights — load after */
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Extralight.woff2') format('woff2'); font-weight:200; font-display:optional; }
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Medium.woff2') format('woff2');     font-weight:500; font-display:optional; }
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Semibold.woff2') format('woff2');   font-weight:600; font-display:optional; }
      @font-face { font-family:'GraphikLCG'; src:url('/fonts/GraphikLCG-Bold.woff2') format('woff2');       font-weight:700; font-display:optional; }

      /* ── Theme Variables ─────────────────────────────────── */
      :root {
        --c-bg:      15,15,15;
        --c-surface: 20,20,20;
        --c-card:    26,26,26;
        --c-text:    255,255,255;
        --c-muted:   161,161,170;
        --partner-filter: brightness(0) invert(1);
      }
      html.light {
        --c-bg:      247,247,247;
        --c-surface: 255,255,255;
        --c-card:    237,237,237;
        --c-text:    15,15,15;
        --c-muted:   100,100,110;
        --partner-filter: none;
      }

      /* ── Theme Utilities ─────────────────────────────────── */
      .t-bg      { background-color: rgb(var(--c-bg))  !important; }
      .t-surface { background-color: rgb(var(--c-surface)) !important; }
      .t-card    { background-color: rgb(var(--c-card)) !important; }
      .t-text    { color: rgb(var(--c-text)) !important; }
      .t-muted   { color: rgb(var(--c-muted)) !important; }
      .t-border        { border-color: rgba(var(--c-text), 0.07) !important; }
      .t-border-subtle { border-color: rgba(var(--c-text), 0.05) !important; }
      .t-text-50  { color: rgba(var(--c-text), 0.50) !important; }
      .t-text-40  { color: rgba(var(--c-text), 0.40) !important; }
      .t-text-30  { color: rgba(var(--c-text), 0.30) !important; }
      .t-text-25  { color: rgba(var(--c-text), 0.25) !important; }

      /* ── Nav Themed Classes ──────────────────────────────── */
      .nav-bg    { background-color: rgba(var(--c-bg), 0.92); }
      .nav-border { border-bottom: 1px solid rgba(var(--c-text), 0.06); }
      .nav-link  { color: rgba(var(--c-text), 0.45); transition: color 0.2s ease; font-size: 13px; }
      .nav-link:hover { color: rgb(var(--c-text)); }
      .nav-cta   { border: 1px solid rgba(var(--c-text), 0.2); color: rgb(var(--c-text)); transition: all 0.2s ease; }
      .nav-cta:hover { background-color: #FF6A00; border-color: #FF6A00; color: #000; }
      .nav-icon-btn { color: rgba(var(--c-text), 0.5); transition: color 0.2s ease, background-color 0.2s ease; }
      .nav-icon-btn:hover { color: rgb(var(--c-text)); background-color: rgba(var(--c-text), 0.07); }
      .ham-bar { background-color: rgb(var(--c-text)); }

      /* ── Footer Themed Classes ───────────────────────────── */
      .footer-link { color: rgba(var(--c-text), 0.60); transition: color 0.2s ease; }
      .footer-link:hover { color: rgb(var(--c-text)); }
      .footer-heading { color: rgba(var(--c-text), 0.9); }
      .footer-dot  { color: rgba(var(--c-text), 0.15); }

      /* ── Smooth theme transition ─────────────────────────── */
      .t-bg,.t-surface,.t-card,.t-text,.t-muted,.t-border,.t-border-subtle,
      .t-text-50,.t-text-40,.t-text-30,.t-text-25,.nav-bg,.nav-border,
      .ham-bar, .footer-link {
        transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
      }

      /* ── Base ────────────────────────────────────────────── */
      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-font-smoothing: antialiased; }
      body { transition: background-color 0.3s ease, color 0.3s ease; }

      /* ── Remove 300ms tap delay on buttons/links ─────────── */
      a, button { touch-action: manipulation; }

      /* ── Content protection ──────────────────────────────── */
      body {
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
      }
      /* Allow selection in form fields */
      input, textarea, select {
        -webkit-user-select: text;
        -moz-user-select: text;
        user-select: text;
      }
      /* Prevent image drag and download */
      img {
        -webkit-user-drag: none;
        user-drag: none;
        pointer-events: none;
      }
      /* Re-enable pointer events for images inside links */
      a img { pointer-events: auto; }
      a img { -webkit-user-drag: none; }

      /* ── Hide cursor on desktop for custom cursor ─────────── */
      @media (pointer: fine) { * { cursor: none !important; } }

      /* ── Scrollbar ───────────────────────────────────────── */
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

      /* ── Hero entrance — transform only, opacity always 1 ─── */
      /* Opacity is never 0 so LCP is measured at first paint   */
      @keyframes heroSlideUp {
        from { transform: translateY(32px); }
        to   { transform: translateY(0); }
      }
      .hero-label    { animation: heroSlideUp 0.75s cubic-bezier(0.16,1,0.3,1) forwards; }
      .hero-headline { animation: heroSlideUp 1.00s cubic-bezier(0.16,1,0.3,1) forwards; }
      .hero-desc     { animation: heroSlideUp 0.85s cubic-bezier(0.16,1,0.3,1) 0.1s both; }
      .hero-buttons  { animation: heroSlideUp 0.75s cubic-bezier(0.16,1,0.3,1) 0.2s both; }
    </style>
  </head>

  <body class="t-bg t-text font-sans antialiased overflow-x-hidden">

    <!-- Skip to main content for keyboard/screen reader/AI users -->
    <a href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm focus:font-semibold"
      style="background:#FF6A00;color:#000;">
      {lang === 'it' ? 'Vai al contenuto principale' : lang === 'de' ? 'Zum Hauptinhalt springen' : 'Skip to main content'}
    </a>

    <Navbar client:load lang={lang} />

    <main id="main-content">
      <slot />
    </main>

    <!-- ── Footer ──────────────────────────────────────────── -->
    <footer id="contatti" style="border-top:1px solid rgba(var(--c-text),0.06);">
      <div class="max-w-[1400px] mx-auto px-6 md:px-12 pt-16 pb-10">

        <!-- Top: logo + tagline + CTA -->
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-10 mb-14">
          <div class="max-w-xs">
            <a href={withLang('/', lang)} aria-label="ED Digital Agency — Home">
              <img id="footer-logo" src="/Images/Logo%20ED%20Digitla.png" alt="ED Digital Agency" width="56" height="56" class="h-14 w-auto mb-5" loading="lazy" />
            </a>
            <p class="text-sm leading-relaxed" style="color:rgba(var(--c-muted),1)">
              {t.footer.tagline}
            </p>
          </div>

          <a href={withLang('/contatti', lang)}
            class="self-start inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold uppercase tracking-widest transition-all duration-200 active:scale-95"
            style="background:#FF6A00; color:#000;">
            {t.footer.cta}
          </a>
        </div>

        <!-- Nav columns -->
        <nav aria-label={t.footer.navHeading}>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-10 mb-14">

          <!-- Servizi -->
          <div>
            <p class="footer-heading text-xs font-semibold uppercase tracking-[0.18em] mb-5">{t.footer.servicesHeading}</p>
            <ul class="space-y-3 text-sm">
              <li><a href={withLang('/servizi/social-media-management', lang)} class="footer-link">Social Media</a></li>
              <li><a href={withLang('/servizi/advertising', lang)} class="footer-link">Advertising</a></li>
              <li><a href={withLang('/servizi/website', lang)} class="footer-link">Website</a></li>
              <li><a href={withLang('/servizi/ecommerce', lang)} class="footer-link">E-Commerce</a></li>
              <li><a href={withLang('/servizi/photo-video', lang)} class="footer-link">Photo & Video</a></li>
              <li><a href={withLang('/servizi/visual-identity', lang)} class="footer-link">Visual Identity</a></li>
              <li><a href={withLang('/servizi/mvp-saas', lang)} class="footer-link">MVP & SaaS</a></li>
              <li><a href={withLang('/servizi/app', lang)} class="footer-link">App</a></li>
              <li><a href={withLang('/servizi/integrazioni', lang)} class="footer-link">Integrazioni</a></li>
            </ul>
          </div>

          <!-- Agenzia -->
          <div>
            <p class="footer-heading text-xs font-semibold uppercase tracking-[0.18em] mb-5">{t.footer.agencyHeading}</p>
            <ul class="space-y-3 text-sm">
              <li><a href={withLang('/', lang)} class="footer-link">{t.footer.home}</a></li>
              <li><a href={withLang('/servizi', lang)} class="footer-link">{t.footer.services}</a></li>
              <li><a href={withLang('/#casistudio', lang)} class="footer-link">{t.footer.projects}</a></li>
              <li><a href={withLang('/blog', lang)} class="footer-link">{t.footer.blog}</a></li>
              <li><a href={withLang('/contatti', lang)} class="footer-link">{t.footer.contact}</a></li>
            </ul>
          </div>

          <!-- Contatti -->
          <div class="col-span-2 md:col-span-2">
            <p class="footer-heading text-xs font-semibold uppercase tracking-[0.18em] mb-5">{t.footer.contactHeading}</p>
            <ul class="space-y-3 text-sm">
              <li>
                <a href="mailto:info@eddigitalagency.it" class="footer-link flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  info@eddigitalagency.it
                </a>
              </li>
              <li>
                <a href="tel:+393793248371" class="footer-link flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.1 6.1l.91-.9a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                  +39 379 324 8371
                </a>
              </li>
            </ul>
          </div>
        </div>
        </nav>

        <!-- Bottom bar -->
        <div style="border-top:1px solid rgba(var(--c-text),0.06); padding-top:2rem;"
          class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs" style="color:rgba(var(--c-text),0.55);">
            {t.footer.copyright}
          </p>
          <div class="flex items-center gap-4 text-xs">
            <a href={withLang('/privacy-policy', lang)} class="footer-link">{t.footer.privacy}</a>
            <span class="footer-dot" aria-hidden="true">·</span>
            <a href={withLang('/cookie-policy', lang)} class="footer-link">{t.footer.cookie}</a>
          </div>
          <p class="text-xs" aria-hidden="true" style="color:rgba(var(--c-text),0.50);">
            {t.footer.countryLine}
          </p>
          <!-- Social icons -->
          <div class="flex items-center gap-4">
            <a href="https://instagram.com/eddigitalagency" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"/></svg>
            </a>
            <a href="https://linkedin.com/company/ed-digital-agency" target="_blank" rel="noopener noreferrer" class="footer-link" aria-label="LinkedIn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Footer logo inversion follows theme -->
    <script is:inline>
      (function(){
        function syncLogo(){
          var el=document.getElementById('footer-logo');
          if(el) el.style.filter=document.documentElement.classList.contains('light')?'invert(1)':'none';
        }
        syncLogo();
        var obs=new MutationObserver(syncLogo);
        obs.observe(document.documentElement,{attributes:true,attributeFilter:['class']});
      })();
    </script>

    <!-- Content protection -->
    <script is:inline>
      // Block right-click on images
      document.addEventListener('contextmenu', function(e) {
        if (e.target.tagName === 'IMG') e.preventDefault();
      });
      // Block common download shortcuts
      document.addEventListener('keydown', function(e) {
        const k = e.key.toLowerCase();
        if ((e.ctrlKey || e.metaKey) && (k === 's' || k === 'u' || k === 'p')) {
          e.preventDefault();
        }
      });
    </script>

    <!-- Analytics tracking: pageview, time on page, clicks, sections -->
    <script is:inline>
      (function(){
        try {
          if (window.location.pathname.startsWith('/admin')) return;
          if (localStorage.getItem('ed-cookie-consent') !== 'all') {
            window.addEventListener('ed-cookie-consent', function(e) {
              if (e.detail === 'all') initTracking();
            }, { once: true });
            return;
          }
          initTracking();
          function initTracking() {
          var sid = sessionStorage.getItem('_ed_sid');
          if (!sid) {
            sid = Math.random().toString(36).slice(2,9) + Date.now().toString(36);
            sessionStorage.setItem('_ed_sid', sid);
          }
          var path = window.location.pathname;
          var t0 = Date.now();
          // Pageview
          fetch('/api/track',{method:'POST',headers:{'Content-Type':'application/json'},
            body:JSON.stringify({type:'pageview',path:path,referrer:document.referrer||null,sessionId:sid}),keepalive:true});
          // Time on page via sendBeacon on unload
          var _sent = false;
          function sendTime(){
            if(_sent) return; _sent=true;
            var secs = Math.round((Date.now()-t0)/1000);
            if(secs<1) return;
            navigator.sendBeacon && navigator.sendBeacon('/api/track',
              new Blob([JSON.stringify({type:'timeonpage',path:path,sessionId:sid,value:secs})],{type:'application/json'}));
          }
          window.addEventListener('beforeunload',sendTime);
          window.addEventListener('pagehide',sendTime);
          // Click tracking
          document.addEventListener('click',function(e){
            var el = e.target && e.target.closest && e.target.closest('a,button,[data-track]');
            if(!el) return;
            var label = (el.getAttribute('data-track')||'') ||
              (el.innerText && el.innerText.trim().slice(0,80)) ||
              el.getAttribute('aria-label')||'';
            label = label.trim();
            if(!label || label.length<2) return;
            fetch('/api/track',{method:'POST',headers:{'Content-Type':'application/json'},
              body:JSON.stringify({type:'click',path:path,sessionId:sid,element:label}),keepalive:true});
          },{passive:true});
          // Section visibility tracking
          if(typeof IntersectionObserver!=='undefined'){
            var seen={};
            var obs=new IntersectionObserver(function(entries){
              entries.forEach(function(en){
                var id=en.target.id||en.target.getAttribute('data-section');
                if(en.isIntersecting&&id&&!seen[id]){
                  seen[id]=1;
                  fetch('/api/track',{method:'POST',headers:{'Content-Type':'application/json'},
                    body:JSON.stringify({type:'section',path:path,sessionId:sid,element:id}),keepalive:true});
                }
              });
            },{threshold:0.3});
            document.querySelectorAll('section[id],[data-section]').forEach(function(s){obs.observe(s);});
          }
          } // end initTracking
        } catch(e){}
      })();
    </script>

    <CustomCursor client:idle />
    <CookieBanner client:idle lang={lang} />

  </body>
</html>
