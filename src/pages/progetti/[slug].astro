---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import ProjectDetailPage from '../../components/ProjectDetailPage';
import { initDB, getPool } from '../../lib/db';
import { getProject } from '../../data/projects';
import type { Project } from '../../data/projects';

const { slug } = Astro.params;

await initDB();
type ProjRow = {
  slug: string; title: string; service: string; service_slug: string;
  services: string[]; service_slugs: string[];
  cover_img: string; tagline: string; description: string;
  what: string[]; results: { value: string; label: string }[]; year: string;
};
const res = await getPool().query<ProjRow>(
  'SELECT * FROM projects_db WHERE slug=$1 AND published=true', [slug]
);

let project: Project | undefined;
if (res.rowCount) {
  const r = res.rows[0];
  const services     = Array.isArray(r.services)      && r.services.length      ? r.services      : [r.service];
  const serviceSlugs = Array.isArray(r.service_slugs) && r.service_slugs.length ? r.service_slugs : [r.service_slug];
  project = {
    slug:         r.slug,
    title:        r.title,
    service:      services[0] ?? r.service,
    serviceSlug:  serviceSlugs[0] ?? r.service_slug,
    services,
    serviceSlugs,
    img:          r.cover_img,
    tagline:      r.tagline,
    description:  r.description,
    what:         Array.isArray(r.what) ? r.what : [],
    results:      Array.isArray(r.results) ? r.results : [],
    year:         r.year,
  };
} else {
  project = getProject(slug!);
}

if (!project) return Astro.redirect('/');

const canonicalURL  = `https://eddigitalagency.it/progetti/${project.slug}`;
const projectImg    = new URL(project.img || '/Images/Logo%20ED%20Digitla.png', 'https://eddigitalagency.it').toString();
const servicesList  = project.services?.length ? project.services : [project.service];
const pageKeywords  = [
  project.title, ...servicesList, 'case study ' + project.service, 'progetto ED Digital Agency',
  'agenzia digitale Treviso', 'Vittorio Veneto', 'Veneto',
].join(', ');

const creativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonicalURL}#project`,
  "name": project.title,
  "headline": project.tagline,
  "description": project.description,
  "url": canonicalURL,
  "image": projectImg,
  "inLanguage": "it-IT",
  "creator": { "@id": "https://eddigitalagency.it/#organization" },
  "about": servicesList.map(s => ({ "@type": "Thing", "name": s })),
  ...(project.year ? { "datePublished": project.year } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",     "item": "https://eddigitalagency.it/" },
    { "@type": "ListItem", "position": 2, "name": "Progetti", "item": "https://eddigitalagency.it/#casistudio" },
    { "@type": "ListItem", "position": 3, "name": project.title, "item": canonicalURL }
  ]
};
---

<Layout
  title={`${project.title} — ${project.service}`}
  description={`${project.tagline} Scopri come ED Digital Agency ha realizzato il progetto ${project.title}: ${project.description.slice(0, 120)}...`}
  pageKeywords={pageKeywords}
  ogImage={project.img}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <ProjectDetailPage client:load project={project} />
</Layout>
