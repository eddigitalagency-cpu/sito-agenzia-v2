---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import ProductsPage from '../../components/ProductsPage';
import { initDB, getPool } from '../../lib/db';

await initDB();
type Row = { slug: string; name: string; category: string; tagline: string; price_note: string; cover_img: string };
const rows = (await getPool().query<Row>(
  "SELECT slug, name, category, tagline, price_note, cover_img FROM products WHERE published=true ORDER BY display_order, created_at DESC"
)).rows;
const products = rows.map(r => ({
  slug: r.slug, name: r.name, category: r.category, tagline: r.tagline,
  priceNote: r.price_note, coverImg: r.cover_img,
}));

const BASE = 'https://eddigitalagency.it';
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",     "item": `${BASE}/` },
    { "@type": "ListItem", "position": 2, "name": "Prodotti", "item": `${BASE}/prodotti` },
  ],
};
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${BASE}/prodotti#page`,
  "name": "Prodotti Software — ED Digital Agency",
  "url": `${BASE}/prodotti`,
  "description": "Gestionali in abbonamento sviluppati da ED Digital Agency per settori specifici: agenzie immobiliari, studi di tatuaggi e altri.",
  "inLanguage": "it-IT",
  "isPartOf": { "@id": `${BASE}/#website` },
  "about": { "@id": `${BASE}/#organization` },
  "hasPart": products.map(p => ({
    "@type": "SoftwareApplication",
    "name": p.name,
    "url": `${BASE}/prodotti/${p.slug}`,
    "description": p.tagline,
    "applicationCategory": "BusinessApplication",
  })),
};
---

<Layout
  title="Prodotti — Gestionali Software su Abbonamento"
  description="I gestionali sviluppati da ED Digital Agency per settori specifici: software per agenzie immobiliari, studi di tatuaggi e altre attività, disponibili in abbonamento."
  pageKeywords="gestionale agenzia immobiliare, software gestionale abbonamento, gestionale studio tatuaggi, software SaaS PMI, gestionale settoriale Treviso, ED Digital Agency prodotti"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>
  <ProductsPage client:load products={products} />
</Layout>
