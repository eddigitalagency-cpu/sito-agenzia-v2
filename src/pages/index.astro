---
import Layout from '../layouts/Layout.astro';
import HomePage from '../components/HomePage';
import { initDB, getPool } from '../lib/db';

export const prerender = false;

await initDB();
type ProjCard = { slug: string; title: string; service: string; services?: string[]; img: string };
const rows = (await getPool().query<{ slug: string; title: string; service: string; services: string[]; cover_img: string }>(
  "SELECT slug, title, service, services, cover_img FROM projects_db WHERE published=true ORDER BY display_order, created_at DESC"
)).rows;
const projects: ProjCard[] = rows.map(r => ({
  slug: r.slug, title: r.title, service: r.service,
  services: Array.isArray(r.services) && r.services.length ? r.services : undefined,
  img: r.cover_img,
}));

type Partner = { src: string; alt: string; w: number };
const partnerRows = (await getPool().query<{ name: string; logo_url: string; width: number }>(
  "SELECT name, logo_url, width FROM technology_partners WHERE published=true ORDER BY display_order, id"
)).rows;
const partners: Partner[] = partnerRows.map(r => ({ src: r.logo_url, alt: r.name, w: r.width }));
---

<Layout
  title="Agenzia Digitale a Treviso e Vittorio Veneto"
  description="ED Digital Agency è l'agenzia digitale di riferimento a Vittorio Veneto, in provincia di Treviso. Social media, advertising, siti web, e-commerce, visual identity e sviluppo di software gestionali e applicazioni su misura per PMI che vogliono crescere online."
  pageKeywords="agenzia digitale Treviso, web agency Vittorio Veneto, agenzia marketing Treviso, social media management Treviso, siti web Treviso, advertising Meta Google Treviso, e-commerce Treviso, agenzia comunicazione Veneto, marketing PMI Treviso, preventivo gratuito agenzia digitale Treviso, ED Digital Agency, agenzia digitale Conegliano, web design Veneto, software gestionale personalizzato, sviluppo applicazioni web su misura, gestionale custom PMI, sviluppo MVP e SaaS Treviso, sviluppo app mobile Veneto"
>
  <HomePage client:load projects={projects} partners={partners} />
</Layout>
