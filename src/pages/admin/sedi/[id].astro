---
export const prerender = false;
import { getPool, initDB } from '../../../lib/db';
import { countries, getCountryByCode } from '../../../data/countries';
import { geocodeAddress } from '../../../lib/geocode';
// Auth + "sedi" permission already enforced by src/middleware.ts

await initDB();
const db = getPool();

const { id } = Astro.params;
const isNew = id === 'nuova';
const officeId = isNew ? 0 : parseInt(id ?? '0');

type OfficeRow = {
  id: number; country_code: string; region: string; province: string; city: string; street: string;
  display_order: number; published: boolean;
};

let office: OfficeRow | null = null;
if (!isNew) {
  if (!officeId) return Astro.redirect('/admin/sedi');
  const res = await db.query<OfficeRow>('SELECT * FROM offices WHERE id=$1', [officeId]);
  if (!res.rowCount) return Astro.redirect('/admin/sedi');
  office = res.rows[0];
}

let errorMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const countryCode = String(form.get('country_code') ?? '').trim().toUpperCase();
  const region       = String(form.get('region')   ?? '').trim();
  const province     = String(form.get('province') ?? '').trim();
  const city         = String(form.get('city')     ?? '').trim();
  const street       = String(form.get('street')   ?? '').trim();
  const published    = form.get('published') === 'on';
  const order        = parseInt(String(form.get('display_order') ?? '0')) || 0;

  if (!countryCode) {
    errorMsg = 'Seleziona un paese.';
  } else {
    try {
      // Geocode the most precise address we have, so the map pin lands on the
      // real city/street instead of the country's centroid. Falls back to
      // null (handled by getPublishedOfficeMarkers) if it can't be resolved.
      const countryName = getCountryByCode(countryCode)?.it ?? countryCode;
      const query = [street, city, province, region, countryName].filter(Boolean).join(', ');
      const geo = await geocodeAddress(query);
      const lat = geo?.lat ?? null;
      const lng = geo?.lng ?? null;

      if (isNew) {
        await db.query(
          `INSERT INTO offices (country_code,region,province,city,street,published,display_order,lat,lng)
           VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)`,
          [countryCode, region, province, city, street, published, order, lat, lng],
        );
      } else {
        await db.query(
          `UPDATE offices SET country_code=$1,region=$2,province=$3,city=$4,street=$5,published=$6,display_order=$7,lat=$8,lng=$9,updated_at=NOW()
           WHERE id=$10`,
          [countryCode, region, province, city, street, published, order, lat, lng, officeId],
        );
      }
      return Astro.redirect('/admin/sedi');
    } catch {
      errorMsg = 'Errore nel salvataggio.';
    }
  }
}

const o = office;
const pageTitle = isNew ? 'Nuova Sede' : 'Modifica Sede';
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{pageTitle} — Admin</title>
  <meta name="robots" content="noindex,nofollow"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:#080808;color:#fff;font-family:system-ui,sans-serif;min-height:100vh;}
    a{color:inherit;text-decoration:none;}
    .topbar{display:flex;align-items:center;gap:12px;padding:0 28px;border-bottom:1px solid rgba(255,255,255,.07);background:#0d0d0d;position:sticky;top:0;z-index:20;height:56px;}
    .brand{font-size:12px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.4);}
    .badge{background:#FF6A00;color:#000;font-size:10px;font-weight:800;padding:3px 8px;border-radius:99px;}
    .btn-back{padding:7px 14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:rgba(255,255,255,.45);font-size:12px;text-decoration:none;white-space:nowrap;}
    .btn-back:hover{color:#fff;border-color:rgba(255,255,255,.25);}
    .wrap{max-width:560px;margin:0 auto;padding:32px 24px;}
    .page-title{font-size:22px;font-weight:800;margin-bottom:28px;}
    .error-box{background:rgba(255,68,68,.1);border:1px solid rgba(255,68,68,.3);border-radius:10px;padding:12px 16px;color:#ff6666;font-size:13px;margin-bottom:20px;}
    .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
    @media(max-width:560px){.form-grid{grid-template-columns:1fr;}}
    .form-full{grid-column:1/-1;}
    .field{display:flex;flex-direction:column;gap:6px;}
    .field label{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.35);font-weight:600;}
    .field input,.field select{
      padding:10px 14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);
      border-radius:9px;color:#fff;font-size:14px;font-family:inherit;outline:none;transition:border-color .15s;
    }
    .field input:focus,.field select:focus{border-color:rgba(255,106,0,.5);}
    .field input::placeholder{color:rgba(255,255,255,.2);}
    .field select option{background:#1a1a1a;color:#fff;}
    .field-hint{font-size:11px;color:rgba(255,255,255,.25);margin-top:2px;}
    .toggle-row{display:flex;align-items:center;gap:10px;}
    .toggle-row input[type=checkbox]{width:18px;height:18px;accent-color:#FF6A00;cursor:pointer;}
    .toggle-row label{font-size:14px;color:rgba(255,255,255,.75);cursor:pointer;}
    .form-actions{display:flex;gap:12px;align-items:center;margin-top:8px;}
    .btn-save{padding:12px 28px;background:#FF6A00;color:#000;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:.07em;transition:opacity .15s;}
    .btn-save:hover{opacity:.85;}
    .btn-cancel-link{padding:12px 20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:9px;color:rgba(255,255,255,.5);font-size:13px;text-decoration:none;transition:all .15s;}
    .btn-cancel-link:hover{color:#fff;border-color:rgba(255,255,255,.25);}
  </style>
</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:10px">
      <span class="brand">ED Digital</span>
      <span class="badge">Admin</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;margin-left:auto;">
      <a href="/admin/sedi" class="btn-back">← Sedi</a>
    </div>
  </div>

  <div class="wrap">
    <div class="page-title">{pageTitle}</div>

    {errorMsg && <div class="error-box">{errorMsg}</div>}

    <form method="POST">
      <div class="form-grid">

        <div class="field form-full">
          <label>Paese *</label>
          <select name="country_code" required>
            <option value="">— Seleziona —</option>
            {countries.map(c => (
              <option value={c.code} selected={o?.country_code === c.code}>{c.it}</option>
            ))}
          </select>
          <span class="field-hint">Serve anche per posizionare il pallino sulla mappa</span>
        </div>

        <div class="field">
          <label>Regione</label>
          <input type="text" name="region" value={o?.region ?? ''} placeholder="Es. Veneto"/>
        </div>

        <div class="field">
          <label>Provincia</label>
          <input type="text" name="province" value={o?.province ?? ''} placeholder="Es. Treviso"/>
        </div>

        <div class="field">
          <label>Comune</label>
          <input type="text" name="city" value={o?.city ?? ''} placeholder="Es. Vittorio Veneto"/>
          <span class="field-hint">Consigliato se il Paese non basta a capire dove siete (es. Vienna per l'Austria)</span>
        </div>

        <div class="field form-full">
          <label>Via</label>
          <input type="text" name="street" value={o?.street ?? ''} placeholder="Es. Via Carlo Torres 17"/>
        </div>

        <div class="field">
          <label>Ordine visualizzazione</label>
          <input type="number" name="display_order" value={o?.display_order ?? 0} min="0" max="999"/>
          <span class="field-hint">Numeri più bassi appaiono prima</span>
        </div>

        <div class="field form-full">
          <div class="toggle-row">
            <input type="checkbox" name="published" id="chk-published" checked={o?.published !== false}/>
            <label for="chk-published">Visibile sul sito</label>
          </div>
        </div>

      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save">{isNew ? 'Crea Sede' : 'Salva Modifiche'}</button>
        <a href="/admin/sedi" class="btn-cancel-link">Annulla</a>
      </div>
    </form>
  </div>
</body>
</html>
