---
export const prerender = false;
import { getPool, initDB } from '../../../lib/db';
import { hashPassword, PERMISSIONS } from '../../../lib/adminAuth';
// Owner-only access already enforced by src/middleware.ts

await initDB();
const db = getPool();

const { id } = Astro.params;
const isNew = id === 'nuovo';
const userId = isNew ? 0 : parseInt(id ?? '0');

type UserRow = { id: number; email: string; name: string; permissions: string[]; active: boolean };

let user: UserRow | null = null;
if (!isNew) {
  if (!userId) return Astro.redirect('/admin/impostazioni');
  const res = await db.query<UserRow>('SELECT id,email,name,permissions,active FROM admin_users WHERE id=$1', [userId]);
  if (!res.rowCount) return Astro.redirect('/admin/impostazioni');
  user = res.rows[0];
}

let errorMsg = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const email    = String(form.get('email') ?? '').trim().toLowerCase();
  const name     = String(form.get('name')  ?? '').trim();
  const password = String(form.get('password') ?? '');
  const active   = form.get('active') === 'on';
  const permissions = PERMISSIONS
    .map(p => p.key)
    .filter(key => form.get(`perm_${key}`) === 'on');

  if (!email) {
    errorMsg = "L'email è obbligatoria.";
  } else if (isNew && !password) {
    errorMsg = 'La password è obbligatoria per un nuovo collaboratore.';
  } else {
    try {
      if (isNew) {
        await db.query(
          `INSERT INTO admin_users (email,password_hash,name,permissions,active)
           VALUES ($1,$2,$3,$4,$5)`,
          [email, hashPassword(password), name, permissions, active],
        );
      } else if (password) {
        await db.query(
          `UPDATE admin_users SET email=$1,name=$2,permissions=$3,active=$4,password_hash=$5,updated_at=NOW() WHERE id=$6`,
          [email, name, permissions, active, hashPassword(password), userId],
        );
      } else {
        await db.query(
          `UPDATE admin_users SET email=$1,name=$2,permissions=$3,active=$4,updated_at=NOW() WHERE id=$5`,
          [email, name, permissions, active, userId],
        );
      }
      return Astro.redirect('/admin/impostazioni');
    } catch (e: unknown) {
      const msg = e instanceof Error ? e.message : String(e);
      errorMsg = msg.includes('unique') ? 'Esiste già un account con questa email.' : 'Errore nel salvataggio.';
    }
  }
}

const u = user;
const pageTitle = isNew ? 'Nuovo Collaboratore' : 'Modifica Collaboratore';
const currentPerms = u?.permissions ?? [];
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{pageTitle} — Admin</title>
  <meta name="robots" content="noindex,nofollow"/>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{background:#080808;color:#fff;font-family:system-ui,sans-serif;min-height:100vh;}
    a{color:inherit;text-decoration:none;}
    .topbar{display:flex;align-items:center;gap:12px;padding:0 28px;border-bottom:1px solid rgba(255,255,255,.07);background:#0d0d0d;position:sticky;top:0;z-index:20;height:56px;}
    .brand{font-size:12px;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:rgba(255,255,255,.4);}
    .badge{background:#FF6A00;color:#000;font-size:10px;font-weight:800;padding:3px 8px;border-radius:99px;}
    .btn-back{padding:7px 14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:8px;color:rgba(255,255,255,.45);font-size:12px;text-decoration:none;white-space:nowrap;}
    .btn-back:hover{color:#fff;border-color:rgba(255,255,255,.25);}
    .wrap{max-width:560px;margin:0 auto;padding:32px 24px;}
    .page-title{font-size:22px;font-weight:800;margin-bottom:28px;}
    .error-box{background:rgba(255,68,68,.1);border:1px solid rgba(255,68,68,.3);border-radius:10px;padding:12px 16px;color:#ff6666;font-size:13px;margin-bottom:20px;}
    .field{display:flex;flex-direction:column;gap:6px;margin-bottom:20px;}
    .field label{font-size:11px;text-transform:uppercase;letter-spacing:.1em;color:rgba(255,255,255,.35);font-weight:600;}
    .field input{
      padding:10px 14px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);
      border-radius:9px;color:#fff;font-size:14px;font-family:inherit;outline:none;transition:border-color .15s;
    }
    .field input:focus{border-color:rgba(255,106,0,.5);}
    .field input::placeholder{color:rgba(255,255,255,.2);}
    .field-hint{font-size:11px;color:rgba(255,255,255,.25);margin-top:2px;}
    .perm-list{display:flex;flex-direction:column;gap:10px;margin-top:6px;}
    .perm-row{display:flex;align-items:center;gap:10px;padding:10px 14px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.07);border-radius:9px;}
    .perm-row input[type=checkbox]{width:18px;height:18px;accent-color:#FF6A00;cursor:pointer;flex-shrink:0;}
    .perm-row label{font-size:13px;color:rgba(255,255,255,.75);cursor:pointer;}
    .toggle-row{display:flex;align-items:center;gap:10px;}
    .toggle-row input[type=checkbox]{width:18px;height:18px;accent-color:#FF6A00;cursor:pointer;}
    .toggle-row label{font-size:14px;color:rgba(255,255,255,.75);cursor:pointer;}
    .form-actions{display:flex;gap:12px;align-items:center;margin-top:8px;}
    .btn-save{padding:12px 28px;background:#FF6A00;color:#000;border:none;border-radius:9px;font-size:13px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:.07em;transition:opacity .15s;}
    .btn-save:hover{opacity:.85;}
    .btn-cancel-link{padding:12px 20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:9px;color:rgba(255,255,255,.5);font-size:13px;text-decoration:none;transition:all .15s;}
    .btn-cancel-link:hover{color:#fff;border-color:rgba(255,255,255,.25);}
  </style>
</head>
<body>
  <div class="topbar">
    <div style="display:flex;align-items:center;gap:10px">
      <span class="brand">ED Digital</span>
      <span class="badge">Admin</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;margin-left:auto;">
      <a href="/admin/impostazioni" class="btn-back">← Collaboratori</a>
    </div>
  </div>

  <div class="wrap">
    <div class="page-title">{pageTitle}</div>

    {errorMsg && <div class="error-box">{errorMsg}</div>}

    <form method="POST">
      <div class="field">
        <label>Nome</label>
        <input type="text" name="name" value={u?.name ?? ''} placeholder="Es. Mario Rossi"/>
      </div>

      <div class="field">
        <label>Email *</label>
        <input type="email" name="email" required value={u?.email ?? ''} placeholder="collaboratore@eddigitalagency.it"/>
      </div>

      <div class="field">
        <label>Password {isNew ? '*' : ''}</label>
        <input type="password" name="password" placeholder={isNew ? 'Scegli una password' : 'Lascia vuoto per non cambiarla'} required={isNew}/>
        {!isNew && <span class="field-hint">Compilalo solo se vuoi impostarne una nuova</span>}
      </div>

      <div class="field">
        <label>Sezioni visibili</label>
        <div class="perm-list">
          {PERMISSIONS.map(p => (
            <div class="perm-row">
              <input type="checkbox" name={`perm_${p.key}`} id={`perm-${p.key}`} checked={currentPerms.includes(p.key)}/>
              <label for={`perm-${p.key}`}>{p.label}</label>
            </div>
          ))}
        </div>
        <span class="field-hint">Puoi selezionarne quante vuoi, anche nessuna</span>
      </div>

      <div class="field">
        <div class="toggle-row">
          <input type="checkbox" name="active" id="chk-active" checked={u?.active !== false}/>
          <label for="chk-active">Accesso attivo</label>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-save">{isNew ? 'Crea Collaboratore' : 'Salva Modifiche'}</button>
        <a href="/admin/impostazioni" class="btn-cancel-link">Annulla</a>
      </div>
    </form>
  </div>
</body>
</html>
