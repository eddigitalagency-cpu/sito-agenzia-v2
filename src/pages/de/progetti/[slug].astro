---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import ProjectDetailPage from '../../../components/ProjectDetailPage';
import { initDB, getPool } from '../../../lib/db';
import { getProject } from '../../../data/projects';
import { getLocalizedServiceName } from '../../../data/services';
import type { Project } from '../../../data/projects';

const lang = 'de' as const;
const { slug } = Astro.params;

await initDB();
type ProjRow = {
  slug: string; title: string; service: string; service_slug: string;
  services: string[]; service_slugs: string[];
  cover_img: string; tagline: string; description: string;
  what: string[]; results: { value: string; label: string }[]; year: string;
  has_translation: boolean;
};
const res = await getPool().query<ProjRow>(
  `SELECT slug, title, service, service_slug, services, service_slugs, cover_img, year,
          COALESCE(NULLIF(tagline_de,''), tagline)         AS tagline,
          COALESCE(NULLIF(description_de,''), description) AS description,
          COALESCE(what_de, what)                           AS what,
          COALESCE(results_de, results)                     AS results,
          (tagline_de IS NOT NULL AND tagline_de != '')     AS has_translation
   FROM projects_db WHERE slug=$1 AND published=true`, [slug]
);

let project: Project | undefined;
let hasTranslation = true;
if (res.rowCount) {
  const r = res.rows[0];
  const serviceSlugs = Array.isArray(r.service_slugs) && r.service_slugs.length ? r.service_slugs : [r.service_slug];
  const rawServices  = Array.isArray(r.services)      && r.services.length      ? r.services      : [r.service];
  const services = serviceSlugs.map((s, i) => getLocalizedServiceName(s, rawServices[i] ?? rawServices[0], lang));
  project = {
    slug: r.slug, title: r.title,
    service: services[0] ?? r.service, serviceSlug: serviceSlugs[0] ?? r.service_slug,
    services, serviceSlugs,
    img: r.cover_img, tagline: r.tagline, description: r.description,
    what: Array.isArray(r.what) ? r.what : [],
    results: Array.isArray(r.results) ? r.results : [],
    year: r.year,
  };
  hasTranslation = r.has_translation;
} else {
  project = getProject(slug!);
}

if (!project) return Astro.redirect('/de');

const canonicalURL  = `https://eddigitalagency.it/de/progetti/${project.slug}`;
const projectImg    = new URL(project.img || '/Images/Logo%20ED%20Digitla.png', 'https://eddigitalagency.it').toString();
const servicesList  = project.services?.length ? project.services : [project.service];
const pageKeywords  = [
  project.title, ...servicesList, project.service + ' Fallstudie', 'ED Digital Agency Projekt',
  'Digitalagentur Österreich',
].join(', ');

const creativeWorkSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${canonicalURL}#project`,
  "name": project.title,
  "headline": project.tagline,
  "description": project.description,
  "url": canonicalURL,
  "image": projectImg,
  "inLanguage": "de-AT",
  "creator": { "@id": "https://eddigitalagency.it/#organization" },
  "about": servicesList.map(s => ({ "@type": "Thing", "name": s })),
  ...(project.year ? { "datePublished": project.year } : {}),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://eddigitalagency.it/de" },
    { "@type": "ListItem", "position": 2, "name": "Projekte", "item": "https://eddigitalagency.it/de/#casistudio" },
    { "@type": "ListItem", "position": 3, "name": project.title, "item": canonicalURL }
  ]
};
---

<Layout
  lang={lang}
  title={`${project.title} — ${project.service}`}
  description={`${project.tagline} Erfahren Sie, wie ED Digital Agency das Projekt ${project.title} umgesetzt hat: ${project.description.slice(0, 120)}...`}
  pageKeywords={pageKeywords}
  ogImage={project.img}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(creativeWorkSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <ProjectDetailPage client:load project={project} lang={lang} translationFallback={!hasTranslation} />
</Layout>
