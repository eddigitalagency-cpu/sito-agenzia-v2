---
import Layout from '../../layouts/Layout.astro';
import ServiziPage from '../../components/ServiziPage';
import { getLocalizedServices } from '../../data/services';
import { dict } from '../../i18n/dictionary';

export const prerender = true;

const lang = 'de' as const;
const t = dict[lang];
const services = getLocalizedServices(lang);
const BASE = 'https://eddigitalagency.it';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": t.footer.home,     "item": `${BASE}/de` },
    { "@type": "ListItem", "position": 2, "name": t.footer.services, "item": `${BASE}/de/servizi` }
  ]
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${BASE}/de/servizi#page`,
  "name": "Digitalmarketing & individuelle Softwareentwicklung — ED Digital Agency",
  "url": `${BASE}/de/servizi`,
  "description": "Alle Leistungen von ED Digital Agency: Social Media, Advertising, Websites, E-Commerce, Foto & Video, Corporate Design, individuelle Businesssoftware und Automatisierung für Unternehmen in Italien, Österreich und international.",
  "inLanguage": "de-AT",
  "isPartOf": { "@id": `${BASE}/#website` },
  "about": { "@id": `${BASE}/#organization` },
  "hasPart": services.map(s => ({
    "@type": "WebPage",
    "name": s.name,
    "url": `${BASE}/de/servizi/${s.slug}`,
    "description": s.description
  }))
};
---

<Layout
  lang={lang}
  title="Digitalmarketing & individuelle Softwareentwicklung"
  description="Entdecken Sie die Leistungen von ED Digital Agency: Social Media, Advertising, Websites, E-Commerce, Foto & Video, Corporate Design, individuelle Businesssoftware und Automatisierung — für Unternehmen in Italien, Österreich und international."
  pageKeywords="Digitalagentur Leistungen, Social Media Agentur Österreich, Werbeagentur, Webagentur, E-Commerce Agentur, individuelle Businesssoftware, Corporate Design Agentur, MVP Entwicklung Agentur, ED Digital Agency"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  </Fragment>
  <ServiziPage client:load lang={lang} />
</Layout>
