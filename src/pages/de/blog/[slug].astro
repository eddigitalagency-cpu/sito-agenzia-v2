---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import BlogPostPage from '../../../components/BlogPostPage';
import { getPool, initDB } from '../../../lib/db';

const lang = 'de' as const;
const { slug } = Astro.params;
if (!slug) return Astro.redirect('/de/blog');

await initDB();
const db = getPool();

type PostRow = {
  id: number; slug: string; title: string; excerpt: string; content: string;
  category: string; cover_img: string; author: string; read_time: number;
  keywords: string; created_at: string; updated_at: string; has_translation: boolean;
};

const res = await db.query<PostRow>(
  `SELECT id, slug,
          COALESCE(NULLIF(title_de,''),title) AS title,
          COALESCE(NULLIF(excerpt_de,''),excerpt) AS excerpt,
          COALESCE(NULLIF(content_de,''),content) AS content,
          category, cover_img, author, read_time,
          COALESCE(NULLIF(keywords_de,''),keywords) AS keywords,
          created_at, updated_at,
          (title_de IS NOT NULL AND title_de != '') AS has_translation
   FROM blog_posts
   WHERE slug=$1 AND (published=true OR (scheduled_at IS NOT NULL AND scheduled_at <= NOW()))
   LIMIT 1`,
  [slug]
);
if (!res.rowCount) return Astro.redirect('/de/blog');

const post = res.rows[0];

const BASE = 'https://eddigitalagency.it';
const postUrl = `${BASE}/de/blog/${post.slug}`;
const coverAbs = post.cover_img
  ? (post.cover_img.startsWith('http') ? post.cover_img : `${BASE}${post.cover_img}`)
  : `${BASE}/Images/Logo_Bianco_ED.webp`;

const geoSuffix = 'Digitalagentur Österreich, Marketing für Unternehmen';
const postKeywords = [post.keywords, post.category, geoSuffix].filter(Boolean).join(', ');

const datePublished = new Date(post.created_at).toISOString();
const dateModified  = new Date(post.updated_at || post.created_at).toISOString();

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': postUrl,
  'headline': post.title,
  'description': post.excerpt,
  'image': { '@type': 'ImageObject', 'url': coverAbs, 'width': 1200, 'height': 630 },
  'datePublished': datePublished,
  'dateModified': dateModified,
  'author': { '@type': 'Organization', 'name': post.author || 'ED Digital Agency', '@id': `${BASE}/#organization` },
  'publisher': { '@type': 'Organization', 'name': 'ED Digital Agency', '@id': `${BASE}/#organization`, 'logo': { '@type': 'ImageObject', 'url': `${BASE}/Images/Logo%20ED%20Digitla.png` } },
  'mainEntityOfPage': { '@type': 'WebPage', '@id': postUrl },
  'url': postUrl,
  'inLanguage': 'de-AT',
  'articleSection': post.category,
  'keywords': postKeywords,
  'timeRequired': `PT${post.read_time}M`,
  'about': { '@type': 'Thing', 'name': post.category },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': [
    { '@type': 'ListItem', 'position': 1, 'name': 'Startseite', 'item': `${BASE}/de` },
    { '@type': 'ListItem', 'position': 2, 'name': 'Blog',  'item': `${BASE}/de/blog` },
    { '@type': 'ListItem', 'position': 3, 'name': post.title, 'item': postUrl },
  ],
};
---

<Layout
  lang={lang}
  title={post.title}
  description={post.excerpt || `Lesen Sie "${post.title}" im Blog von ED Digital Agency.`}
  ogImage={post.cover_img || undefined}
  ogType="article"
  articleDate={datePublished}
  articleModified={dateModified}
  articleAuthor={post.author || 'ED Digital Agency'}
  articleSection={post.category}
  pageKeywords={postKeywords}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <BlogPostPage client:load post={post} lang={lang} translationFallback={!post.has_translation} />
</Layout>
